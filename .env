# SwarSaarthi Backend Environment Variables
APP_NAME="SwarSaarthi Backend API"

# Database connection string
# For Neon / PostgreSQL: postgresql+asyncpg://user:password@host/dbname?sslmode=require
# For Local SQLite: sqlite+aiosqlite:///./swarsaarthi.db
DATABASE_URL="sqlite+aiosqlite:///./swarsaarthi.db"

# JWT Authentication
JWT_SECRET="swarsaarthi-super-secret-jwt-key-2026-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
